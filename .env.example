# Variables de configuration — à copier dans un fichier .env.local (jamais envoyé sur Git)
# Tant qu'elles sont vides, l'application fonctionne en mode démo avec des données fictives.

# --- Pennylane : API cabinet (écrans : balance, écritures, tiers, GED) ---
# Pennylane › Paramètres cabinet › Firm Tokens — droits en lecture seule
PENNYLANE_FIRM_API_KEY=

# --- Pennylane : serveur MCP (assistant IA) ---
# Adresse et jeton fournis par Pennylane pour son serveur MCP
PENNYLANE_MCP_URL=
PENNYLANE_MCP_TOKEN=

# --- Claude (API Anthropic) : assistant IA ---
# Console Anthropic › API Keys — clé du cabinet
ANTHROPIC_API_KEY=

# --- Microsoft 365 / SharePoint (GED) ---
# Inscription d'application Entra ID avec la permission Microsoft Graph « Sites.Selected »
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
